{
  "name": "michtavim-larebbe",
  "version": "0.1.0",
  "description": "מכתבים לרבי – כתיבת מכתב וקבלת מענה מתוך אגרות הקודש, עם תרגום והסבר",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "mobile:build": "node scripts/build-mobile.mjs && npx cap sync android",
    "apk": "npm run mobile:build && cd android && ./gradlew assembleDebug",
    "catalog": "node scripts/build-catalog.mjs",
    "build:web": "esbuild web/cloud.js --bundle --format=esm --minify --target=es2020 --legal-comments=none --outfile=public/vendor/cloud.js",
    "test:rules": "firebase emulators:exec --project demo-michtavim --only firestore \"node --test test/rules/*.test.mjs\"",
    "abbr-stats": "node scripts/abbr-stats.mjs",
    "icons": "node scripts/build-icons.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@capacitor-firebase/authentication": "^7.5.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@google/genai": "^2.31.0",
    "@napi-rs/canvas": "^1.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase": "^11.10.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.28.2"
  }
}
