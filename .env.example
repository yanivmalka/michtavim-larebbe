# --- Claude (קריאת הדף, תרגום והסבר) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- שרת ---
PORT=3000
# כתובת ציבורית של השרת (נדרש לוואטסאפ כדי לשלוח קישור ל-PDF)
PUBLIC_BASE_URL=http://localhost:3000

# --- מקור אגרות הקודש ---
# remote = הורדת עמוד בודד ממאגר אונליין לפי התבניות למטה
# local  = חיתוך עמוד מקבצי PDF מלאים שבתיקייה data/pdfs (vol-01.pdf, vol-02.pdf ...)
IGROT_SOURCE=remote
# {id} = מזהה הספר במאגר (מוגדר ב-data/volumes.json), {page} = מספר עמוד ב-PDF
IGROT_PAGE_PDF_URL=https://hebrewbooks.org/pagefeed/hebrewbooks_org_{id}_{page}.pdf
IGROT_VIEWER_URL=https://hebrewbooks.org/pdfpager.aspx?req={id}&pgnum={page}

# --- WhatsApp Business (Cloud API) – אופציונלי ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
