# --- הסבר, תרגום וניתוח (רק בלחיצה על הכפתור) ---
# Gemini (ברירת מחדל): מפתח מ-https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# gemini | claude – ריק: Gemini אם יש לו מפתח, אחרת Claude
AI_PROVIDER=
# מגבלת בקשות ניתוח לכל משתמש בשעה
AI_RATE_PER_HOUR=40

# --- Claude (חלופה) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# --- שרת ---
PORT=3000
# כתובת ציבורית של השרת (נדרש לוואטסאפ כדי לשלוח קישור ל-PDF)
PUBLIC_BASE_URL=http://localhost:3000

# --- מקור אגרות הקודש ---
# ברירת מחדל: https://chabadlibrary.org/books
# CHABADLIBRARY_BASE=https://chabadlibrary.org/books
# אורכי האגרות שהשרת למד (משותף לכל המשתמשים). בשרת אירוח – להפנות לדיסק קבוע.
# LENGTHS_FILE=/var/data/letter-lengths.json

# --- עדכוני אפליקציית אנדרואיד ---
# מאגר ה-GitHub שבו מתפרסמות הגרסאות (Releases בתגית app-v<מספר>)
# APP_RELEASES_REPO=yanivmalka/michtavim-larebbe
# נדרש רק אם המאגר פרטי (טוקן עם הרשאת קריאה ל-Contents)
# APP_RELEASES_TOKEN=

# --- WhatsApp Business (Cloud API) – אופציונלי ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0
